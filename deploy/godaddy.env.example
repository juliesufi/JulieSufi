# Copy this file to .env on the GoDaddy server. Do not commit the copy.
# The staging deploy never uploads .env, and it never deletes public/images or public/videos.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=juliesufi

ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
INSTAGRAM_ENCRYPTION_KEY=

# Hosted enquiry mail uses the platform gateway and does not need SMTP_*.
# SMTP_PASSWORD is a Google App Password for local development only.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=contact@juliesufi.com
SMTP_PASSWORD=

# GoDaddy's web server sits in front of Node. Trust its client address for rate limits.
TRUST_PROXY=1

# cPanel "Setup Node.js App" fills PORT. Leave HOST unset unless you need a specific bind address.
# PORT=3000
# HOST=127.0.0.1
