{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "julie-sufi-staging",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Staging database. scripts/cloudflare-staging.mjs replaces database_id
  // before deploy. Do not put passwords in this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "julie-sufi-staging",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "julie-sufi-staging"
    }
  ]
}
